{
  "rules": {
    "office": {
      ".read": true,
      ".write": true,
      "presence": {
        "$pid": {
          ".validate": "newData.hasChildren(['name','zone','status']) || !newData.exists()",
          "name": { ".validate": "newData.isString() && newData.val().length <= 24" },
          "zone": { ".validate": "newData.isString() && newData.val().length <= 16" },
          "status": { ".validate": "newData.isString() && newData.val().length <= 24" },
          "character": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 24)" },
          "message": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 140)" }
        }
      },
      "messages": {
        ".indexOn": ["createdAt"],
        "$mid": {
          ".validate": "newData.hasChildren(['name','text','createdAt'])",
          "text": { ".validate": "newData.isString() && newData.val().length <= 600" }
        }
      },
      "tasks": {
        "$tid": {
          "title": { ".validate": "newData.isString() && newData.val().length <= 200" }
        }
      },
      "decor": {
        ".validate": "newData.hasChildren(['carColor','lightTone','bannerText']) || !newData.exists()",
        "carColor": { ".validate": "!newData.exists() || (newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/))" },
        "lightTone": { ".validate": "!newData.exists() || (newData.isString() && newData.val().matches(/^(gold|warm|cool|emerald|festive)$/))" },
        "bannerText": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 24)" },
        "updatedBy": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 12)" },
        "updatedAt": { ".validate": "!newData.exists() || newData.isNumber()" },
        "props": {
          "$prop": { ".validate": "!newData.exists() || newData.isBoolean()" }
        }
      }
    }
  }
}
